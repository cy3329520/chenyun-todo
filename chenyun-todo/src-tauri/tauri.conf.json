{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "晨云待办",
  "version": "1.0.3",
  "identifier": "com.chenyun.todo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "晨云待办",
        "width": 320,
        "height": 460,
        "minWidth": 300,
        "minHeight": 340,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "晨云待办",
    "longDescription": "极简悬浮待办，置顶、提醒、优先级与拖拽排序",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
